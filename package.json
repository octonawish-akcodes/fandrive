{
  "name": "fandrive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "spike": "QLOO_CACHE_DIR=.cache/qloo tsx --env-file=.env.local scripts/spike.ts",
    "record": "QLOO_CACHE_DIR=.cache/qloo tsx --env-file=.env.local scripts/record-run.ts",
    "method-data": "QLOO_CACHE_DIR=.cache/qloo tsx --env-file=.env.local scripts/method-data.ts",
    "eval": "QLOO_CACHE_DIR=.cache/qloo tsx --env-file=.env.local scripts/eval.ts",
    "validate-age": "QLOO_CACHE_DIR=.cache/qloo tsx --env-file=.env.local scripts/validate-age.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.94",
    "@modelcontextprotocol/server": "^2.3.1",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "ai": "7.0.138",
    "maplibre-gl": "6.14.0",
    "mcp-handler": "2.3.0",
    "nanoid": "6.0.2",
    "next": "16.4.2",
    "p-limit": "7.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@11.9.0"
}
